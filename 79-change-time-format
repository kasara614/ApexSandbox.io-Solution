public String changeTimeFormat(String strTime) {
    String[] parts = strTime.split(':');
    Integer hours24 = Integer.valueOf(parts[0]);
    String minutes = parts[1];

    String period;
    if(hours24 < 12){
        period = 'AM';
    }
    else{
         period = 'PM';
    }

    Integer hours12 = hours24 % 12;
    if(hours12 == 0){
         hours12 = 12;
    }

    String hourStr = String.valueOf(hours12);
    if(hourStr.length() == 1){
        hourStr = '0' + hourStr;
    }

    return hourStr + ':' + minutes + ' ' + period;

}